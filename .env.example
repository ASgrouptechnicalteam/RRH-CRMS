# ─────────────────────────────────────────────────────────────
# CUSTOMER PORTAL INTEGRATION — Phase 11 Packet 3B
# ─────────────────────────────────────────────────────────────
# The Customer Portal does not exist yet. The background worker is
# DISABLED by default and MUST remain disabled until the Portal is
# available and these variables are configured.

# Base URL of the Customer Portal API. Leave empty to keep the worker inert.
# Example: PORTAL_API_URL="https://portal.example.com"
PORTAL_API_URL=""

# Service Bearer Secret CRM → Portal. Must be >= 32 chars, randomly generated.
# NEVER log this value. Example (generate your own):
# CRM_PORTAL_SECRET=""
CRM_PORTAL_SECRET=""

# Service Bearer Secret Portal → CRM. Must be >= 32 chars, randomly generated.
# NEVER log this value. Example (generate your own):
# PORTAL_CRM_SECRET=""
PORTAL_CRM_SECRET=""

# Worker is disabled by default. Set to "true" ONLY when the Portal is live.
PORTAL_WORKER_ENABLED="false"

# Worker poll interval in milliseconds (approved default: 30000).
PORTAL_POLL_INTERVAL_MS="30000"

# ─────────────────────────────────────────────────────────────
# DATA ENCRYPTION — Phase 11 Packet 3C (KYC Data Bridge)
# ─────────────────────────────────────────────────────────────
# Required for AES-256-CBC encryption of sensitive fields (Customer KYC).
# MUST be >= 32 characters and randomly generated. REQUIRED in production —
# the development fallback is NEVER used when NODE_ENV=production.
# Example (generate your own):
# ENCRYPTION_KEY=""
ENCRYPTION_KEY=""

# ── Sonthillu E2E local development ──────────────────────────
# Local API key for Sonthillu public endpoint E2E tests.
# Generated fixtures (3 properties + publication) depend on this key
# being set when NODE_ENV=development. Keep secret; never commit to VCS.
# Example: SONTHILLU_LOCAL_API_KEY="sk_local_abc123def456"
SONTHILLU_LOCAL_API_KEY=""