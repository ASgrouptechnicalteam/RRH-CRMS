# Leave empty for same-domain deploys (uses relative /api/v1 via the 
# dev proxy or same-origin production hosting).
# Set to the full backend URL when frontend and backend are deployed 
# to different domains/subdomains, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL="VITE_API_BASE_URL=https://apirscrm.radharealhomeproperties.com/api/v1"
